#!/bin/bash
source "$(dirname "$0")/_common.sh"
ynh_script_progression --message="Mise à jour de l'application..."
if [ -n "${path%/}" ]; then
    ynh_die "Cette version doit être installée à la racine du domaine."
fi
configure_package
refresh_package_config
ynh_systemctl --service="$app" --action=restart --log_path="systemd" --wait_until="API Yunohost disponible" --timeout=60
